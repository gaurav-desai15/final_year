# LLM backend: "ollama" (default, free, local, no API key) or "anthropic"
# (paid, needs ANTHROPIC_API_KEY below).
CPGVD_LLM_PROVIDER=ollama

# -- Free/local backend (Ollama) --
# Requires Ollama running locally: ./scripts/setup_ollama.sh
CPGVD_OLLAMA_HOST=http://localhost:11434
CPGVD_OLLAMA_MODEL=qwen2.5-coder:7b
CPGVD_OLLAMA_TIMEOUT=300

# -- Paid backend (Claude API) -- only used when CPGVD_LLM_PROVIDER=anthropic.
# If unset, the SDK also picks up an `ant auth login` profile automatically.
ANTHROPIC_API_KEY=
CPGVD_MODEL=claude-opus-4-8

# Where Joern is installed, if not on PATH.
JOERN_HOME=

# Working directories.
CPGVD_WORK_DIR=.cpgvd_cache
CPGVD_OUTPUT_DIR=cpgvd_output

# Tuning knobs (all optional; see src/cpgvd/config.py for defaults).
CPGVD_MAX_CONTEXTS=200
CPGVD_LLM_CONCURRENCY=4
CPGVD_EFFORT=high
CPGVD_MAX_CONTEXT_CHARS=12000
CPGVD_JOERN_PORT=8080
CPGVD_JOERN_STARTUP_TIMEOUT=120
